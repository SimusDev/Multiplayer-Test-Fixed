[sub_resource type="GDScript" id="GDScript_8tnfi"]
resource_name = "toolhun_ui"
script/source = "#toolgun_ui.gd
extends Node

@export var builder:SourceBuilder
@export var toolgun_label:Label3D

func _ready() -> void:
	builder.building_pick.connect(_update)

func _update(source_building:R_SourceBuilding):
	toolgun_label.text = source_building._name
"

