[sub_resource type="GDScript" id="GDScript_roq52"]
script/source = "extends Control

func _ready() -> void:
	$Label.text = \"NIGHT %s\" % str(R_SourceGameScript.global.night.current)
	if SourceEnvironment.is_ready_to_work():
		$Label.text += \"\\n\"
		$Label.text += SourceEnvironment.get_game_time()
"

