[sub_resource type="GDScript" id="GDScript_181f1"]
resource_name = "network_script"
script/source = "extends Node

# Веса для двух входных сигналов и смещение (bias)
var weights = [randf_range(-1, 1), randf_range(-1, 1)]
var bias = randf_range(-1, 1)
var learning_rate = 0.1

func _ready():
	print(\"Начальные веса: \", weights)
	# Обучаем сеть операции \"ИЛИ\" (если хоть один вход 1, то результат 1)
	var training_data = [
		{\"input\": [0, 0], \"target\": 0},
		{\"input\": [0, 1], \"target\": 1},
		{\"input\": [1, 0], \"target\": 1},
		{\"input\": [1, 1], \"target\": 1}
	]
	
	# Цикл обучения (1000 эпох)
	for epoch in range(1000):
		for data in training_data:
			train(data[\"input\"], data[\"target\"])
			
	print(\"Обучение завершено!\")
	test_network()

# Функция активации (Sigmoid)
func activate(x):
	return 1.0 / (1.0 + exp(-x))

# Предсказание
func predict(inputs):
	var sum = bias
	for i in range(inputs.size()):
		sum += inputs[i] * weights[i]
	return activate(sum)

# Обучение методом обратного распространения (упрощенно для 1 нейрона)
func train(inputs, target):
	var guess = predict(inputs)
	var error = target - guess
	
	# Корректировка весов
	for i in range(weights.size()):
		weights[i] += error * inputs[i] * learning_rate
	bias += error * learning_rate

# Проверка результата
func test_network():
	print(\"0 OR 0 = \", round(predict([0, 0])))
	print(\"0 OR 1 = \", round(predict([0, 1])))
	print(\"1 OR 0 = \", round(predict([1, 0])))
	print(\"1 OR 1 = \", round(predict([1, 1])))
"

