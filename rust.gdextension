[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.4
reloadable = false

[libraries]
linux.debug.x86_64 =     "rust/target/debug/rust.so"
linux.release.x86_64 =   "rust/target/release/rust.so"
windows.debug.x86_64 =   "rust/target/debug/rust.dll"
windows.release.x86_64 = "rust/target/release/rust.dll"
macos.debug =            "rust/target/debug/rust.dylib"
macos.release =          "rust/target/release/rust.dylib"
macos.debug.arm64 =      "rust/target/debug/rust.dylib"
macos.release.arm64 =    "rust/target/release/rust.dylib"
