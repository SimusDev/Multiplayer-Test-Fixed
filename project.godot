SoundPlayer="*res://singletons/s_SoundPlayer.tscn"
SimpleGrass="*res://addons/simplegrasstextured/singleton.tscn"
MidiSingleton="*uid://pget1lr5sl1h"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[dotnet]

project/assembly_name="Multiplayer-Test"

[editor_plugins]

enabled=PackedStringArray("res://addons/YouCanDoIt/plugin.cfg", "res://addons/fancy_editor_sounds/plugin.cfg", "res://addons/flowing-sky/plugin.cfg", "res://addons/midi/plugin.cfg", "res://addons/mixamo_animation_retargeter/plugin.cfg", "res://addons/simplegrasstextured/plugin.cfg", "res://addons/simusdev/plugin.cfg", "res://addons/skeletal_animation_player/plugin.cfg", "res://addons/sky_3d/plugin.cfg", "res://addons/terrain_3d/plugin.cfg")

