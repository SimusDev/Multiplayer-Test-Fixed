[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Multiplayer-Test"
config/version="dev005b"
run/main_scene="uid://c31uhxfwryhme"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="uid://cyj56486e1iyo"

[audio]

buses/default_bus_layout="uid://dkif0mnl8g155"
general/default_playback_type.web=0
driver/enable_input=true

[autoload]

SimusDev="*uid://dnpa241s8gwqq"
SceneChanger="*res://singletons/s_SceneChanger.tscn"
SyncedData="*res://singletons/s_SyncedData.tscn"
Maps="*res://singletons/s_Maps.tscn"
