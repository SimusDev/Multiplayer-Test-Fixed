[layer_names]

3d_physics/layer_1="Entities"
3d_physics/layer_2="Hitboxes"
3d_physics/layer_3="Projectiles"
3d_physics/layer_4="Interactables"
3d_physics/layer_5="AI_Areas"
3d_physics/layer_6="Footstep detectable"

[physics]

common/physics_ticks_per_second=90
3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
reflections/sky_reflections/roughness_layers=32
textures/default_filters/use_nearest_mipmap_filter=true
scaling_3d/mode=1
scaling_3d/mode.ios=1
scaling_3d/mode.macos=1
textures/decals/filter=0
textures/light_projectors/filter=0
occlusion_culling/use_occlusion_culling=true
2d/snap/snap_2d_transforms_to_pixel=true

[shader_globals]

sgt_legacy_renderer={
"type": "int",
"value": 0
}
sgt_player_position={
"type": "vec3",
"value": Vector3(1000000, 1000000, 1000000)
}
sgt_player_mov={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
sgt_normal_displacement={
"type": "sampler2D",
"value": "res://addons/simplegrasstextured/images/normal.png"
}
sgt_motion_texture={
"type": "sampler2D",
"value": "res://addons/simplegrasstextured/images/motion.png"
}
sgt_wind_direction={
"type": "vec3",
"value": Vector3(1, 0, 0)
}
sgt_wind_movement={
"type": "vec3",
"value": Vector2(0, 0)
}
sgt_wind_strength={
"type": "float",
"value": 0.15
}
sgt_wind_turbulence={
"type": "float",
"value": 1.0
}
sgt_wind_pattern={
"type": "sampler2D",
"value": "res://addons/simplegrasstextured/images/wind_pattern.png"
}
